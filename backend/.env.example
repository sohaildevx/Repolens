# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database (NeonDB)
DATABASE_URL=postgresql://user:YOUR_PASSWORD@ep-xxxxx-xxxxx.us-east-2.aws.neon.tech/repolens?sslmode=require

# NVIDIA Nemotron AI via Nebius Token Factory (OpenAI-compatible inference API)
# Docs verified: https://tokenfactory.nebius.com/docs  (OpenAI SDK + /v1/ base URL)
# Fill these in YOUR .env yourself. This example file is safe to commit;
# your real .env never is (see .gitignore).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Pick a Nemotron ID from YOUR account's catalog (official catalog:
# https://tokenfactory.nebius.com/models/catalog), e.g.:
#   nvidia/nemotron-3-super-120b-a12b          (120B, good for code reasoning)
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B      (30B, faster/cheaper)
# List the IDs enabled on your account (run this yourself in your shell):
#   curl -s https://api.tokenfactory.nebius.com/v1/models -H "Authorization: Bearer $NEBIUS_API_KEY"
NEBIUS_MODEL=
# Optional: AI request timeout in seconds (default 30)
NEBIUS_TIMEOUT=30
